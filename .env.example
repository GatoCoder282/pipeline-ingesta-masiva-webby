# Local runtime
INGESTION_DATA_DIR=./data
INGESTION_DEFAULT_ENTITY=productos
INGESTION_MAX_ROWS=100000

# Webby API. Use a development tenant-scoped JWT, never a production token in Git.
WEBBY_BASE_URL=http://localhost:8000
WEBBY_API_TOKEN=
WEBBY_TENANT_SLUG=piel-radiante-bo
WEBBY_TIMEOUT_SECONDS=60
WEBBY_POLL_INTERVAL_SECONDS=2
WEBBY_MAX_POLL_SECONDS=900

# Kestra local database
POSTGRES_USER=ingestion
POSTGRES_PASSWORD=ingestion_dev_only
POSTGRES_DB=kestra

# Optional n8n profile
N8N_ENCRYPTION_KEY=change-this-local-key
